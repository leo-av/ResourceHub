# ==============================================================================
# ResourceHub — Plantilla de Variables de Entorno para PostgreSQL 16 (Neon)
# ==============================================================================
# Copiar este archivo a `.env` (o usar `scripts/setup-env.sh`) y completar con
# las credenciales reales no versionadas.
# NUNCA confirmar el archivo `.env` en el control de versiones.
# ==============================================================================

# Metadatos del Proyecto en Neon (Serverless PostgreSQL 16)
NEON_PROJECT_ID=late-king-57958158
NEON_BRANCH_ID=br-falling-dust-bh6j017z
NEON_ENDPOINT_ID=ep-lively-cherry-bh7xy3tq
NEON_REGION=aws-eu-central-1
NEON_API_KEY=CHANGE_ME_NEON_API_KEY_OPTIONAL

# Coordenadas de Red y Base de Datos Única de Pruebas (DTE-PG-01 / DTE-PG-02)
PG_HOST=ep-lively-cherry-bh7xy3tq.c-10.eu-central-1.aws.neon.tech
PG_POOLER_HOST=ep-lively-cherry-bh7xy3tq-pooler.c-10.eu-central-1.aws.neon.tech
PG_PORT=5432
PG_DB=resourcehub
PG_SSLMODE=require

# ------------------------------------------------------------------------------
# 1. Usuario Administrativo y de Migraciones Flyway (`admin`)
#    Uso exclusivo para administración de esquemas, DDL y ejecución de Flyway.
#    PROHIBIDO usar este usuario desde la aplicación ResourceHub en ejecución.
# ------------------------------------------------------------------------------
PG_ADMIN_USER=admin
PG_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
PG_ADMIN_JDBC_URL=jdbc:postgresql://${PG_HOST}:${PG_PORT}/${PG_DB}?sslmode=${PG_SSLMODE}&ApplicationName=resourcehub-flyway-admin

# ------------------------------------------------------------------------------
# 2. Usuario de Aplicación (`dba_api`)
#    Uso habitual de los servicios de ResourceHub (lectura/escritura DML y
#    secuencias en los 11 esquemas aprobados, sin permisos DDL).
# ------------------------------------------------------------------------------
PG_APP_USER=dba_api
PG_APP_PASSWORD=CHANGE_ME_STRONG_DBA_API_PASSWORD
PG_APP_JDBC_URL=jdbc:postgresql://${PG_HOST}:${PG_PORT}/${PG_DB}?sslmode=${PG_SSLMODE}&ApplicationName=resourcehub-app
PG_APP_POOLER_JDBC_URL=jdbc:postgresql://${PG_POOLER_HOST}:${PG_PORT}/${PG_DB}?sslmode=${PG_SSLMODE}&ApplicationName=resourcehub-app
