# ==============================================================================
# ResourceHub — Especificación de Conexión Separada (Aplicación vs. Administración)
# ==============================================================================
# Fase 5: Los servicios de aplicación de ResourceHub DEBEN conectarse siempre
# con el rol `dba_api` (DML + secuencias) y NUNCA con el rol `admin`.
# ==============================================================================

# --- A. CONEXIÓN DE APLICACIÓN (Servicios Backend XF de ResourceHub) ---
RESOURCEHUB_DB_HOST=ep-lively-cherry-bh7xy3tq.c-10.eu-central-1.aws.neon.tech
RESOURCEHUB_DB_POOLER_HOST=ep-lively-cherry-bh7xy3tq-pooler.c-10.eu-central-1.aws.neon.tech
RESOURCEHUB_DB_PORT=5432
RESOURCEHUB_DB_NAME=resourcehub
RESOURCEHUB_DB_SSLMODE=require
RESOURCEHUB_DB_USER=dba_api
RESOURCEHUB_DB_PASSWORD=${PG_APP_PASSWORD}
RESOURCEHUB_DB_JDBC_URL=jdbc:postgresql://ep-lively-cherry-bh7xy3tq.c-10.eu-central-1.aws.neon.tech:5432/resourcehub?sslmode=require&ApplicationName=resourcehub-app
RESOURCEHUB_DB_SEARCH_PATH=platform_catalog,org_config,access,resources,availability,reservations,policies,traceability,events,integrations,payments,public
RESOURCEHUB_DB_TRANSACTION_ISOLATION=READ_COMMITTED
RESOURCEHUB_DB_TIMEZONE=UTC

# --- B. CONEXIÓN ADMINISTRATIVA Y DE MIGRACIONES (Exclusiva Flyway / DBA) ---
RESOURCEHUB_FLYWAY_HOST=ep-lively-cherry-bh7xy3tq.c-10.eu-central-1.aws.neon.tech
RESOURCEHUB_FLYWAY_PORT=5432
RESOURCEHUB_FLYWAY_DB_NAME=resourcehub
RESOURCEHUB_FLYWAY_SSLMODE=require
RESOURCEHUB_FLYWAY_USER=admin
RESOURCEHUB_FLYWAY_PASSWORD=${PG_ADMIN_PASSWORD}
RESOURCEHUB_FLYWAY_JDBC_URL=jdbc:postgresql://ep-lively-cherry-bh7xy3tq.c-10.eu-central-1.aws.neon.tech:5432/resourcehub?sslmode=require&ApplicationName=resourcehub-flyway-admin
